  gameTitle: "Hotel Doppelg\xE4nger"
  startText: Start
  tutorialButtonText: Controls
  sceneToLoad: 
  pauseWhileOpen: 1
  tutorialTitle: Controls
  tutorialText: 'WASD  -  Walk

    Shift  -  Sprint

    Mouse  -  Look around

    E or Left click  -  Talk to someone

    Hold Left click  -  Pick up and carry things

    Right click while carrying  -  Turn what you''re holding

    Scroll while carrying  -  Move it closer or further away

    E while carrying  -  Show it to someone

    Mouse, number keys or W/S + E  -  Pick what to say

    Tab  -  Leave a conversation

    J  -  Open your journal

    Esc  -  Free the mouse



    !  above someone  -  They have something new to say

    ?  above someone  -  They want to see what you''re holding'
