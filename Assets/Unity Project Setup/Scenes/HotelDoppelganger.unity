MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 204179135}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d57edf726d7ecd34c89b14ffebe53380, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: Helena
  startNode: start
  addGoodbye: 1
  wrongItemReply: I don't see what that has to do with anything.
  portrait: {fileID: 0}
  talkingPortrait: {fileID: 0}
  faceHeightAdjust: 0
  headHeightAdjust: 0
  nodes:
  - id: Start
    npcText: Oh, Detective! Thank goodness. You have to get me out of here. I can't bear another minute in this horrible place.
    expression: {fileID: 0}
    choices:
    - text: Did you see anything tonight?
      nextNode: saw
      endConversation: 0
      greyAfterChosen: 1
      appearAfter: 0
      unlockId: 
      salemThinks: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    - text: How long have you and James been together?
      nextNode: couple
      endConversation: 0
      greyAfterChosen: 1
      appearAfter: 0
      unlockId: 
      salemThinks: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    timeLimit: 0
    timeoutNode: 
  - id: saw
    npcText: Nothing! James and I were near the bar the whole time. Arguing, as usual. He never takes me anywhere nice.
    expression: {fileID: 0}
    choices:
    - text: Arguing about what?
      nextNode: argue
      endConversation: 0
      greyAfterChosen: 1
      appearAfter: 0
      unlockId: 
      salemThinks: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    - text: I had other questions.
      nextNode: start
      endConversation: 0
      greyAfterChosen: 0
      appearAfter: 0
      unlockId: 
      salemThinks: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    timeLimit: 0
    timeoutNode: 
  - id: argue
    npcText: A penthouse! Is that so much to ask? He'd rather buy a private island and lock me away on it.
    expression: {fileID: 0}
    choices:
    - text: I see.
      nextNode: start
      endConversation: 0
      greyAfterChosen: 1
      appearAfter: 0
      unlockId: 
      salemThinks: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    - text: I had other questions.
      nextNode: start
      endConversation: 0
      greyAfterChosen: 0
      appearAfter: 0
      unlockId: 
      salemThinks: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    timeLimit: 0
    timeoutNode: 
  - id: couple
    npcText: Over a year! Longer than anyone else ever lasted. Not that he notices.
    expression: {fileID: 0}
    choices:
    - text: I had other questions.
      nextNode: start
      endConversation: 0
      greyAfterChosen: 0
      appearAfter: 0
      unlockId: 
      salemThinks: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    timeLimit: 0
    timeoutNode: 
  eventDialogue:
  - unlockId: HelenaFraming
    showInNode: 
    text: You said Murray isn't human?
    requiredItem: {fileID: 0}
    npcReply: Did I? Oh, I didn't mean... well. Haven't you noticed? He reeks of the sea. And he never goes near the fire.
    choices:
    - text: That's a big accusation.
      nextNode: framing
      endConversation: 0
      greyAfterChosen: 0
      appearAfter: 0
      unlockId: 
      salemThinks: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    expression: {fileID: 0}
    backText: 
