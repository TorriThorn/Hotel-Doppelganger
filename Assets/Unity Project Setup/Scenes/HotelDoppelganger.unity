  m_Script: {fileID: 11500000, guid: d57edf726d7ecd34c89b14ffebe53380, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: Carmela
  startNode: start
  addGoodbye: 1
  wrongItemReply: I don't see what that has to do with anything.
  portrait: {fileID: 0}
  talkingPortrait: {fileID: 0}
  faceHeightAdjust: 0
  headHeightAdjust: 0
  nodes:
  - id: Start
    npcText: Oh! Detective. Sorry, I'm a little jumpy tonight. Can I help?
    expression: {fileID: 0}
    choices:
    - text: Why are you here tonight?
      nextNode: why
      endConversation: 0
      greyAfterChosen: 1
      appearAfter: 0
      unlockId: 
      salemThinks: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    - text: What do you make of Murray?
      nextNode: murray
      endConversation: 0
      greyAfterChosen: 1
      appearAfter: 0
      unlockId: 
      salemThinks: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    timeLimit: 0
    timeoutNode: 
  - id: why
    npcText: A guest needed a sobering tonic. Him, at the bar. I was meant to drop it off and go home.
    expression: {fileID: 0}
    choices:
    - text: Bad timing.
      nextNode: start
      endConversation: 0
      greyAfterChosen: 1
      appearAfter: 0
      unlockId: 
      salemThinks: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    timeLimit: 0
    timeoutNode: 
  - id: murray
    npcText: Murray... I can't put my finger on it, but something about him feels off. He hasn't gone near the fire once, and it's freezing in here.
    expression: {fileID: 0}
    choices:
    - text: I'll keep an eye on him.
      nextNode: start
      endConversation: 0
      greyAfterChosen: 1
      appearAfter: 0
      unlockId: 
      salemThinks: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    timeLimit: 0
    timeoutNode: 
  eventDialogue:
  - unlockId: 
    showInNode: 
    text: Do you know what this is?
    requiredItem: {fileID: 1012264499}
    npcReply: Put that away! Do you know what that's made from? Please, I don't want to be anywhere near it.
    choices:
    - text: Right.
      nextNode: 
      endConversation: 1
      greyAfterChosen: 0
      appearAfter: 0
      unlockId: 
      salemThinks: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    expression: {fileID: 0}
    backText: 
    greyAfterChosen: 1
    nextNode: 
