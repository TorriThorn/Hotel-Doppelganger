--- !u!114 &413268095
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 413268092}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d57edf726d7ecd34c89b14ffebe53380, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: Zain
  startNode: start
  addGoodbye: 1
  wrongItemReply: I don't see what that has to do with anything.
  portrait: {fileID: 0}
  talkingPortrait: {fileID: 0}
  faceHeightAdjust: 0
  headHeightAdjust: 0
  nodes:
  - id: Start
    npcText: Detective. Whatever it is, I didn't do it. I've been right here all night.
    expression: {fileID: 0}
    choices:
    - text: How long have you been drinking?
      nextNode: drinking
      endConversation: 0
      greyAfterChosen: 1
      appearAfter: 0
      unlockId: 
      salemThinks: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    - text: You used to work for James?
      nextNode: james
      endConversation: 0
      greyAfterChosen: 1
      appearAfter: 0
      unlockId: 
      salemThinks: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    - text: Did you know Geno?
      nextNode: geno
      endConversation: 0
      greyAfterChosen: 1
      appearAfter: 0
      unlockId: 
      salemThinks: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    timeLimit: 0
    timeoutNode: 
  - id: drinking
    npcText: Since about... what year is it?
    expression: {fileID: 0}
    choices:
    - text: Be serious.
      nextNode: serious
      endConversation: 0
      greyAfterChosen: 1
      appearAfter: 0
      unlockId: 
      salemThinks: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    timeLimit: 0
    timeoutNode: 
  - id: serious
    npcText: Since I got to this city. You move around a lot when people want things from you.
    expression: {fileID: 0}
    choices:
    - text: Who wants things from you?
      nextNode: debt
      endConversation: 0
      greyAfterChosen: 1
      appearAfter: 0
      unlockId: 
      salemThinks: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    - text: I had other questions
      nextNode: start
      endConversation: 0
      greyAfterChosen: 0
      appearAfter: 0
      unlockId: 
      salemThinks: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    timeLimit: 0
    timeoutNode: 
  - id: debt
    npcText: Nobody. Forget it. I didn't say anything...
    expression: {fileID: 0}
    choices:
    - text: Sure
      nextNode: start
      endConversation: 0
      greyAfterChosen: 1
      appearAfter: 0
      unlockId: 
      salemThinks: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    timeLimit: 0
    timeoutNode: 
  - id: james
    npcText: Used to. His company chews people up. Twenty hour days. I wasn't the only one who needed a drink to sleep
    expression: {fileID: 0}
    choices:
    - text: Sounds rough.
      nextNode: start
      endConversation: 0
      greyAfterChosen: 1
      appearAfter: 0
      unlockId: 
      salemThinks: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    timeLimit: 0
    timeoutNode: 
  - id: geno
    npcText: Only that he hated James even more than I do. Good man. Probably.
    expression: {fileID: 0}
    choices:
    - text: Probably?
      nextNode: start
      endConversation: 0
      greyAfterChosen: 1
      appearAfter: 0
      unlockId: 
      salemThinks: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    timeLimit: 0
    timeoutNode: 
  eventDialogue:
  - unlockId: 
    showInNode: 
    text: Do you recognize this?
    requiredItem: {fileID: 101083546}
    npcReply: Where did you get that? Get it away from me! That's what they make the stuff from. If they see you with it...
    choices:
    - text: okay.
      nextNode: 
      endConversation: 1
      greyAfterChosen: 0
      appearAfter: 0
      unlockId: 
      salemThinks: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    expression: {fileID: 0}
    backText: 
    greyAfterChosen: 1
    nextNode: 
    endConversation: 0
    salemThinks: 
    onChosen:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 413268097}
          m_TargetAssemblyTypeName: NPCPatrol, Assembly-CSharp
          m_MethodName: StopAtWaypoint
          m_Mode: 2
          m_Arguments:
            m_ObjectArgument: {fileID: 933341416}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Transform, UnityEngine
            m_IntArgument: 0
