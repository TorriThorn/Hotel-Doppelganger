  m_Script: {fileID: 11500000, guid: d57edf726d7ecd34c89b14ffebe53380, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: Sobrina
  startNode: start
  addGoodbye: 1
  nodes:
  - id: start
    npcText: Lets just get this done...
    choices:
    - text: Who are you?
      nextNode: who
      endConversation: 0
      greyAfterChosen: 1
      unlockId: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    - text: Who is he?
      nextNode: Him
      endConversation: 0
      greyAfterChosen: 1
      unlockId: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    - text: What do you know about the body?
      nextNode: Body
      endConversation: 0
      greyAfterChosen: 1
      unlockId: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    - text: 
      nextNode: event_topic
      endConversation: 0
      greyAfterChosen: 0
      unlockId: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
  - id: who
    npcText: Names Sobrina.
    choices:
    - text: What are you doing here?
      nextNode: What
      endConversation: 0
      greyAfterChosen: 0
      unlockId: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    - text: I had other questions.
      nextNode: start
      endConversation: 0
      greyAfterChosen: 0
      unlockId: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
  - id: Him
    npcText: Seems like a snob didn't really speak to him much.
    choices:
    - text: I had other questions.
      nextNode: start
      endConversation: 0
      greyAfterChosen: 0
      unlockId: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
  - id: Body
    npcText: 'Didn''t know the guy. But if you find anything bring it to my table near the bar. '
    choices:
    - text: I had other questions.
      nextNode: start
      endConversation: 0
      greyAfterChosen: 0
      unlockId: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
  - id: What
    npcText: Had a rough night and I just needed an escape, what luck.
    choices:
    - text: I had other questions.
      nextNode: start
      endConversation: 0
      greyAfterChosen: 0
      unlockId: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
  eventDialogue:
  - unlockId: BottlePlaced
    showInNode: 
    text: Bottle
    npcReply: Can confirm this is poision. Maybe ask our wine snob about it.
    choices: []
    backText: I had other questions.
    greyAfterChosen: 1
    nextNode: 
    endConversation: 0
