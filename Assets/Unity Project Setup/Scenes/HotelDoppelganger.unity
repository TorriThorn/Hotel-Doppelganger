  boxColor: {r: 0, g: 0, b: 0, a: 0.92}
  borderColor: {r: 0.85, g: 0.83, b: 0.78, a: 0.5}
  nameColor: {r: 0.45, g: 0.44, b: 0.41, a: 1}
