      endConversation: 0
      greyAfterChosen: 0
      unlockId: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
  - id: What
    npcText: Im a regular here, this place has reds that are to die for.
    choices:
    - text: I had other questions.
      nextNode: start
      endConversation: 0
      greyAfterChosen: 0
      unlockId: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
  - id: Witch
    npcText: The other patron of the bar tonight, she doesn't talk much but shes a "doctor" from what I gather.
    choices:
    - text: I had other questions.
      nextNode: start
      endConversation: 0
      greyAfterChosen: 0
      unlockId: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
  - id: Body
    npcText: He used to be the taverns owner, great friend, though a little dry.
    choices:
    - text: I had other questions.
      nextNode: start
      endConversation: 0
      greyAfterChosen: 0
      unlockId: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
  - id: event_BottlePlaced
