      greyAfterChosen: 1
      unlockId: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
  - id: who
    npcText: 'Names Angelo '
    choices:
    - text: What are you doing here?
      nextNode: What
      endConversation: 0
      greyAfterChosen: 0
      unlockId: 
      onChosen:
        m_PersistentCalls:
          m_Calls: []
    - text: I had other questions.
